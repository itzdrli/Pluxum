{
	"name": "@pluxum/domain",
	"version": "0.0.0",
	"description": "Shared types, errors and contracts of the Pluxum forum plugins.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itzdrli/Pluxum.git",
		"directory": "packages/domain"
	},
	"type": "module",
	"files": [
		"dist",
		"!**/*.map"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "vp run compile",
		"typecheck": "vp run check-types",
		"test": "vp run check-tests"
	},
	"devDependencies": {
		"typescript": "catalog:tooling",
		"vite-plus": "catalog:tooling",
		"vitest": "catalog:test"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"access": "public"
	}
}
