{
	"name": "@pluxum/core",
	"version": "0.0.0",
	"description": "Pluxum forum core: users, roles, categories, threads, posts, the extension registries, Markdown rendering and the cache.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itzdrli/Pluxum.git",
		"directory": "plugins/core"
	},
	"type": "module",
	"files": [
		"dist",
		"!**/*.map"
	],
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json",
		"./control": {
			"types": "./dist/control/index.d.mts",
			"import": "./dist/control/index.mjs",
			"default": "./dist/control/index.mjs"
		}
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"@pluxum/domain": "workspace:*",
		"drizzle-orm": "catalog:backend",
		"marked": "catalog:backend",
		"sanitize-html": "catalog:backend",
		"valibot": "catalog:validation",
		"valibot-form": "catalog:validation"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@mantine/core": "catalog:frontend",
		"@mantine/hooks": "catalog:frontend",
		"@pluxel/cli": "catalog:pluxel",
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/host": "catalog:pluxel",
		"@pluxel/plugin-cache": "catalog:pluxel",
		"@pluxel/services": "catalog:pluxel",
		"@pluxel/test": "catalog:pluxel",
		"@pluxel/workbench": "catalog:pluxel",
		"@tabler/icons-react": "catalog:frontend",
		"@types/react": "catalog:frontend",
		"@types/react-dom": "catalog:frontend",
		"@types/sanitize-html": "catalog:tooling",
		"capnweb": "catalog:prod",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"typescript": "catalog:tooling",
		"vite-plus": "catalog:tooling",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@mantine/core": "catalog:frontend-peer",
		"@mantine/hooks": "catalog:frontend-peer",
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/host": "catalog:pluxel",
		"@pluxel/plugin-cache": "catalog:pluxel",
		"@pluxel/services": "catalog:pluxel",
		"@pluxel/workbench": "catalog:pluxel",
		"@tabler/icons-react": "catalog:frontend-peer",
		"capnweb": "catalog:prod",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend"
	},
	"peerDependenciesMeta": {
		"@pluxel/host": {
			"optional": true
		}
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true,
		"workbenchCapnweb": "0.13.1",
		"pluginPackages": {
			"@pluxel/plugin-cache": "required"
		},
		"control": "./dist/control/manifest.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json",
			"./control": {
				"types": "./dist/control/index.d.mts",
				"import": "./dist/control/index.mjs",
				"default": "./dist/control/index.mjs"
			}
		},
		"access": "public"
	}
}
