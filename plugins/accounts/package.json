{
	"name": "@pluxum/accounts",
	"version": "0.0.0",
	"description": "Email and password accounts for Pluxum, so a forum can run without an identity provider.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itzdrli/Pluxum.git",
		"directory": "plugins/accounts"
	},
	"type": "module",
	"files": [
		"dist",
		"!**/*.map"
	],
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"@pluxum/domain": "workspace:*",
		"drizzle-orm": "catalog:backend",
		"valibot": "catalog:validation",
		"valibot-form": "catalog:validation"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@pluxel/cli": "catalog:pluxel",
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/host": "catalog:pluxel",
		"@pluxel/plugin-rates": "catalog:pluxel",
		"@pluxel/services": "catalog:pluxel",
		"@pluxel/test": "catalog:pluxel",
		"@pluxel/workbench": "catalog:pluxel",
		"@pluxum/auth": "workspace:*",
		"@pluxum/core": "workspace:*",
		"@pluxum/mail": "workspace:*",
		"@types/node": "catalog:tooling",
		"typescript": "catalog:tooling",
		"vite-plus": "catalog:tooling",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/plugin-rates": "catalog:pluxel",
		"@pluxel/services": "catalog:pluxel",
		"@pluxel/workbench": "catalog:pluxel",
		"@pluxum/auth": "workspace:^",
		"@pluxum/core": "workspace:^",
		"@pluxum/mail": "workspace:^"
	},
	"peerDependenciesMeta": {
		"@pluxum/mail": {
			"optional": true
		}
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true,
		"pluginPackages": {
			"@pluxum/auth": "required",
			"@pluxum/core": "required",
			"@pluxum/mail": "optional",
			"@pluxel/plugin-rates": "required"
		}
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public"
	}
}
