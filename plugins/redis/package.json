{
	"name": "@pluxum/redis",
	"version": "0.0.0",
	"description": "Redis capability provider used by the Pluxum host.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itzdrli/Pluxum.git",
		"directory": "plugins/redis"
	},
	"type": "module",
	"files": [
		"dist",
		"!**/*.map"
	],
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json",
		"./control": {
			"types": "./dist/control/index.d.mts",
			"import": "./dist/control/index.mjs",
			"default": "./dist/control/index.mjs"
		}
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"devDependencies": {
		"@pluxel/cli": "catalog:pluxel",
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/host": "catalog:pluxel",
		"@pluxel/plugin-redis": "catalog:pluxel",
		"@pluxel/test": "catalog:pluxel",
		"typescript": "catalog:tooling",
		"vite-plus": "catalog:tooling",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/host": "catalog:pluxel",
		"@pluxel/plugin-redis": "catalog:pluxel"
	},
	"peerDependenciesMeta": {
		"@pluxel/host": {
			"optional": true
		}
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true,
		"control": "./dist/control/manifest.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json",
			"./control": {
				"types": "./dist/control/index.d.mts",
				"import": "./dist/control/index.mjs",
				"default": "./dist/control/index.mjs"
			}
		},
		"access": "public"
	},
	"dependencies": {
		"redis": "catalog:backend",
		"valibot": "catalog:validation",
		"valibot-form": "catalog:validation"
	}
}
