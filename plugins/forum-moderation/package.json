{
	"name": "@forum/forum-moderation",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"@forum/domain": "workspace:*",
		"drizzle-orm": "catalog:backend",
		"typebox": "catalog:backend",
		"valibot": "catalog:validation"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@forum/forum-api": "workspace:*",
		"@forum/forum-auth": "workspace:*",
		"@forum/forum-core": "workspace:*",
		"@pluxel/cli": "catalog:pluxel",
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/host": "catalog:pluxel",
		"@pluxel/services": "catalog:pluxel",
		"@pluxel/test": "catalog:pluxel",
		"typescript": "catalog:tooling",
		"vite-plus": "catalog:tooling",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@forum/forum-api": "workspace:*",
		"@forum/forum-auth": "workspace:*",
		"@forum/forum-core": "workspace:*",
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/services": "catalog:pluxel"
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true,
		"pluginPackages": {
			"@forum/forum-api": "required",
			"@forum/forum-auth": "required",
			"@forum/forum-core": "required"
		}
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	}
}
