{
	"name": "@pluxum/api",
	"version": "0.0.0",
	"description": "Pluxum forum HTTP API: routes, caller resolution and the wire contract.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itzdrli/Pluxum.git",
		"directory": "plugins/api"
	},
	"type": "module",
	"files": [
		"dist",
		"!**/*.map"
	],
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json",
		"./control": {
			"types": "./dist/control/index.d.mts",
			"import": "./dist/control/index.mjs",
			"default": "./dist/control/index.mjs"
		}
	},
	"scripts": {
		"build": "vp run compile",
		"test": "vp run check-tests",
		"typecheck": "vp run check-types"
	},
	"dependencies": {
		"@pluxum/domain": "workspace:*",
		"elysia": "catalog:backend",
		"typebox": "catalog:backend"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:prod",
		"@pluxum/auth": "workspace:*",
		"@pluxum/core": "workspace:*",
		"@pluxel/cli": "catalog:pluxel",
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/host": "catalog:pluxel",
		"@pluxel/services": "catalog:pluxel",
		"@pluxel/test": "catalog:pluxel",
		"typescript": "catalog:tooling",
		"vite-plus": "catalog:tooling",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@pluxel/core": "catalog:pluxel",
		"@pluxel/host": "catalog:pluxel",
		"@pluxel/services": "catalog:pluxel",
		"@pluxum/auth": "workspace:^",
		"@pluxum/core": "workspace:^"
	},
	"peerDependenciesMeta": {
		"@pluxel/host": {
			"optional": true
		}
	},
	"pluxel": {
		"artifactRoot": "dist",
		"nodeArtifacts": true,
		"workbenchArtifacts": true,
		"pluginPackages": {
			"@pluxum/auth": "required",
			"@pluxum/core": "required"
		},
		"control": "./dist/control/manifest.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json",
			"./control": {
				"types": "./dist/control/index.d.mts",
				"import": "./dist/control/index.mjs",
				"default": "./dist/control/index.mjs"
			}
		},
		"access": "public"
	}
}
