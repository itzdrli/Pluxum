# Copy to .env next to compose.yaml and fill in. See docs/deploy.md.

# Domain the forum is served on (HTTPS is required: sign-in cookies are Secure).
PLUXUM_DOMAIN=forum.example.com

# Password of the bundled PostgreSQL. Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Sign-in through any OpenID Connect provider (Zitadel, Keycloak, Authentik, Auth0, ...).
# Redirect URI to register there: https://<PLUXUM_DOMAIN>/api/forum/auth/callback
# A confidential client's secret is entered in Workbench afterwards, never here.
# Leave both empty to start without sign-in (read-only guests).
FORUM_OIDC_ISSUER=
FORUM_OIDC_CLIENT_ID=
# true: signing out of the forum also ends the provider session.
FORUM_OIDC_PROVIDER_LOGOUT=false
# Comma-separated provider user IDs ("sub" claim) that become forum admins when they sign in.
FORUM_ADMIN_SUBJECTS=

# Image tag: latest, or a release such as 0.1.0.
PLUXUM_VERSION=latest

# Where the web container listens on this machine. Keep loopback when a reverse proxy runs here;
# with `--profile caddy` it is not used by anything outside.
PLUXUM_HTTP_BIND=127.0.0.1
PLUXUM_HTTP_PORT=3000

# Workbench (admin) port, bound to this machine's loopback only. From your computer:
#   ssh -L 8080:127.0.0.1:8080 <server>   then open http://localhost:8080/__pluxel/workbench
PLUXUM_ADMIN_PORT=8080
